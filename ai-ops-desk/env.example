# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourAppName"
MONGODB_DATABASE=ai_ops_desk

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# =============================================================================
# Galileo + Agent Control
# =============================================================================
# This demo supports two Agent Control modes, toggled by AGENT_CONTROL_MODE:
#
#   enterprise (default) -- Agent Control Enterprise (ACE), hosted inside the
#       Galileo cluster. Controls are created in Galileo Console and bound to
#       a log stream. GALILEO_API_KEY doubles as the AC credential.
#
#   oss -- Self-hosted standalone Agent Control server (e.g. docker compose
#       locally). Controls are created via setup_agent_control.py.
#       AGENT_CONTROL_API_KEY is the runtime credential.
#
# Set AGENT_CONTROL_MODE below to switch between them. Vars used only by one
# mode are labeled inline.
# =============================================================================

# enterprise | oss
AGENT_CONTROL_MODE="enterprise"

# Console + API URLs for the Galileo stack you're pointing at. Required for
# enterprise mode (used to resolve project/log stream IDs). Optional for
# oss mode but recommended -- Galileo logging still works regardless.
GALILEO_CONSOLE_URL="https://console-<stack>.gcp-dev.galileo.ai"
GALILEO_API_URL="https://api-<stack>.gcp-dev.galileo.ai"

GALILEO_API_KEY="your-galileo-api-key"

# Project + log stream you created in Console. The log stream is the binding
# target for ACE controls.
GALILEO_PROJECT="ai_ops_desk"
GALILEO_LOG_STREAM="dev-1"

# -----------------------------------------------------------------------------
# Agent Control -- shared
# -----------------------------------------------------------------------------

# enterprise: https://agent-control-<stack>.gcp-dev.galileo.ai
# oss:        http://localhost:8000  (or your hosted standalone server)
AGENT_CONTROL_URL="https://agent-control-<stack>.gcp-dev.galileo.ai"

# Set to "false" to disable agent-control wiring entirely (CI / no-server runs).
AGENT_CONTROL_ENABLED="true"

# Agent name registered with the server. Hard-coded in the SDK init helper,
# but you can override here for one-off experiments.
AGENT_CONTROL_AGENT_NAME="ai-ops-desk"

# How often the SDK polls for control changes (seconds). Default in the SDK
# is 60s; we use 5s during demos so toggling a control takes effect quickly.
# Set to 0 to disable polling.
AGENT_CONTROL_REFRESH_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Agent Control -- enterprise mode only
# -----------------------------------------------------------------------------

# ACE binds controls to a log stream rather than to an agent.
AGENT_CONTROL_TARGET_TYPE="log_stream"

# ACE's runtime auth mode. "jwt" exchanges your Galileo API key for a
# log-stream-scoped JWT on each evaluation request.
AGENT_CONTROL_RUNTIME_AUTH_MODE="jwt"

# Header the upstream Galileo auth shim expects.
AGENT_CONTROL_API_KEY_HEADER="Galileo-API-Key"

# -----------------------------------------------------------------------------
# Agent Control -- oss mode only
# -----------------------------------------------------------------------------

# Runtime API key the SDK presents on every @control() call. Must match one
# of AGENT_CONTROL_API_KEYS on the server. Leave empty if the server has
# AGENT_CONTROL_API_KEY_ENABLED=false (local dev only).
# AGENT_CONTROL_API_KEY=""

# Admin key used by setup_agent_control.py to create/attach controls.
# Must match one of AGENT_CONTROL_ADMIN_API_KEYS on the server. Only needed
# when running setup; the long-running FastAPI process never reads it.
# AGENT_CONTROL_ADMIN_API_KEY=""
