# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourAppName"
MONGODB_DATABASE=ai_ops_desk

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Galileo Configuration

GALILEO_API_KEY="your-galileo-api-key"

GALILEO_PROJECT="ai_ops_desk"
GALILEO_LOG_STREAM="dev-1"

# =============================================================================
# Agent Control Configuration
# =============================================================================
# Local dev (no auth):
#   curl -L https://raw.githubusercontent.com/agentcontrol/agent-control/refs/heads/main/docker-compose.yml | docker compose -f - up -d
#
# Local dev (auth ON, mirrors prod — recommended before deploying):
#   See "Test with auth locally" section in README.md
#
# Pinned image versions used in prod:
#   galileoai/agent-control-server:7.7.0
#   galileoai/agent-control-ui:7.7.0
# =============================================================================

# URL of the Agent Control server. On Railway use the internal hostname:
#   http://${{agent-control-server.RAILWAY_PRIVATE_DOMAIN}}:8000
AGENT_CONTROL_URL="http://localhost:8000"

# Set to "false" to disable agent-control wiring entirely (useful for CI / no-server runs).
AGENT_CONTROL_ENABLED="true"

# API key used by the SDK at RUNTIME for @control() calls and observability.
# Must match one of AGENT_CONTROL_API_KEYS on the server side.
# Leave empty if the server has AGENT_CONTROL_API_KEY_ENABLED=false (local dev only).
AGENT_CONTROL_API_KEY=""

# Admin API key used by setup_agent_control.py to CREATE/ATTACH controls.
# Must match one of AGENT_CONTROL_ADMIN_API_KEYS on the server side.
# Only needed when running setup; the long-running FastAPI process never reads it.
# Leave empty if auth is disabled.
AGENT_CONTROL_ADMIN_API_KEY=""

# How often the SDK polls the server for control changes (seconds). SDK
# default is 60s; we use 5s here so toggling a control in the dashboard
# takes effect quickly during live demos. Set to 0 to disable polling
# entirely (controls are then only refreshed on process restart).
AGENT_CONTROL_REFRESH_INTERVAL_SECONDS=5

